{
  "info": {
    "name": "Arogya Mitra - Authenticated APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Supply credentials locally. CSRF tokens are fetched automatically; the Postman cookie jar holds one active identity. Switching role replaces that session. Use the CLI workflow for concurrent patient/provider/admin isolation. Activation tokens come from local Mailpit; never commit them."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:9090/api"
    },
    {
      "key": "adminUsername",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "providerUsername",
      "value": ""
    },
    {
      "key": "providerPassword",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "providerId",
      "value": ""
    },
    {
      "key": "patientId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "activationToken",
      "value": ""
    },
    {
      "key": "date",
      "value": ""
    },
    {
      "key": "time",
      "value": "10:00"
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.sendRequest({url:pm.variables.get('baseUrl')+'/auth/csrf',method:'GET'},(error,response)=>{if(error)throw error;pm.variables.set('csrfToken',response.json().token);});",
          "const parts=Object.fromEntries(new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Kolkata',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date()).map(p=>[p.type,p.value]));",
          "pm.collectionVariables.set('date',new Date(Date.UTC(+parts.year,+parts.month-1,+parts.day+1)).toISOString().slice(0,10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Public and provider application",
      "item": [
        {
          "name": "Current session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Public providers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/providers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
