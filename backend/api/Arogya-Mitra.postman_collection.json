          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Your full name\",\n  \"username\": \"{{providerUsername}}\",\n  \"email\": \"applicant@example.test\",\n  \"phone\": \"9876543210\",\n  \"organization\": \"Your clinic\",\n  \"designation\": \"mbbs\",\n  \"village\": \"rama\",\n  \"registrationId\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('applicationId',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Activate from Mailpit link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/activate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{activationToken}}\",\n  \"password\": \"{{providerPassword}}\"\n}",
              "options": {
