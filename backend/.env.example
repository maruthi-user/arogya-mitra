# Set these in the backend process environment. This file is a template, not automatically loaded.
# First start only: create the initial administrator. Never commit a real password.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Mailpit defaults. Inbox: http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@arogyamitra.local

# Optional local PostgreSQL profile
DB_URL=jdbc:postgresql://localhost:5432/arogya_mitra
DB_USERNAME=
DB_PASSWORD=

# HTTPS deployment: set secure=true and use the appropriate SameSite policy for your topology.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Patient SMS/WhatsApp messages. "log" only writes them to the backend log.
# For a real gateway set MESSAGING_PROVIDER=webhook and an https:// MESSAGING_WEBHOOK_URL that
# accepts POST {"to","text","channel"}; MESSAGING_WEBHOOK_TOKEN is sent as a Bearer token.
MESSAGING_PROVIDER=log
MESSAGING_WEBHOOK_URL=
MESSAGING_WEBHOOK_TOKEN=
MESSAGING_CHANNEL=sms
